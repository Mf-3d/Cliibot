{
  "name": "cliibot",
  "version": "0.3.5",
  "description": "It could be a robot.",
  "scripts": {
    "build": "npm run check && tsgo -p ./tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node ./dist/main.js",
    "dev": "npm run check && tsx ./src/main.ts",
    "check": "tsgo --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mf-3d/logger": "github:mf-3d/logger#v0.3.1",
    "chalk": "^6.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "strip-ansi": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  },
  "homepage": "https://github.com/Mf-3d/Cliibot#readme",
  "bugs": {
    "url": "https://github.com/Mf-3d/Cliibot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mf-3d/Cliibot.git"
  },
  "license": "MIT",
  "author": "mf7cli",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "github:mf-3d/logger#3d7000b65921e729dd93c9f442236f91d8ca3c1b": true
  },
  "type": "module"
}
